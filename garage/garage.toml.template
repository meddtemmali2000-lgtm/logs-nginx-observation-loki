# /etc/garage.toml — Garage v2.5.0 (single-node, stockage S3 pour Loki)
# Remplacer __RPC_SECRET__ et __ADMIN_TOKEN__ / __METRICS_TOKEN__ à l'installation.

metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "0.0.0.0:3901"
rpc_public_addr = "172.18.40.129:3901"
rpc_secret = "__RPC_SECRET__"

[s3_api]
s3_region = "garage"
api_bind_addr = "0.0.0.0:3900"
root_domain = ".s3.garage.local"
public_endpoint = "http://172.18.40.129:3900"

[s3_web]
bind_addr = "127.0.0.1:3902"
root_domain = ".web.garage.local"
index = "index.html"

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token = "__ADMIN_TOKEN__"
metrics_token = "__METRICS_TOKEN__"
